endsnippet

// ============================================
// ПРЕДЕЛЫ
// ============================================
snippet lim "limit" iAm
lim_($1 -> $2) $0
endsnippet
snippet liminf "limit inferior" iAm
liminf_($1 -> $2) $0
endsnippet
snippet limsup "limit superior" iAm
limsup_($1 -> $2) $0
endsnippet

// ============================================
// СУММЫ И ПРОИЗВЕДЕНИЯ
// ============================================
snippet sum "sum" iAm
sum_($1 = $2)^($3) $0
endsnippet
snippet prod "product" iAm
prod_($1 = $2)^($3) $0
endsnippet
snippet coprod "coproduct" iAm
coprod_($1 = $2)^($3) $0
endsnippet

// ============================================


// ИНТЕГРАЛЫ
// ============================================
snippet int "integral" iAm
